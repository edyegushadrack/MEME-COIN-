# Free RPC endpoint (Helius/QuickNode free tier both work, or public mainnet-beta)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# PumpPortal is free, no key required for the public data stream
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# Supabase project (create a NEW free project for this, separate from your booking SaaS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Scoring thresholds — tune these once you have data
MIN_SCORE_TO_LOG_AS_CANDIDATE=40
MIN_SCORE_TO_PAPER_BUY=65

# Paper trading assumptions (no real funds move)
PAPER_POSITION_SIZE_SOL=0.5

# Telegram alerts + /track /untrack wallet monitoring commands
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
